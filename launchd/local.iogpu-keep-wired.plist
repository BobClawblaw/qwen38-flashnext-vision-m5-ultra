<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- At boot: keep the GPU's wired memory wired between requests (README, GPU memory). Root-owned, in /Library/LaunchDaemons. -->
  <key>Label</key>
  <string>local.iogpu-keep-wired</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/sbin/sysctl</string>
    <string>iogpu.disable_wired_collector=1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
